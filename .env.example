# Local settings. Keep real secrets in an untracked .env file.
APP_ENV=development
DATABASE_URL=sqlite:///data/vericarb.sqlite3
VERICARB_DATA_DIR=./data
VERICARB_TOKEN_SECRET=replace-with-a-long-random-local-secret
TOKEN_TTL_SECONDS=28800
MAX_UPLOAD_BYTES=10485760
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Public Maculatus settings are verified against the X1 RPC/explorer. Never put
# private keys in this tracked example file.
AI_PROVIDER_API_KEY=
AI_PROVIDER_BASE_URL=
X1_TESTNET_RPC_URL=https://maculatus-rpc.x1eco.com
X1_TESTNET_CHAIN_ID=10778
X1_TESTNET_EXPLORER_URL=https://maculatus-scan.x1eco.com
X1_TESTNET_NATIVE_CURRENCY=X1T
X1_REGISTRY_CONTRACT_ADDRESS=
X1_DEPLOYER_PRIVATE_KEY=
X1_REGISTRAR_PRIVATE_KEY=
X1_REVIEWER_PRIVATE_KEY=
